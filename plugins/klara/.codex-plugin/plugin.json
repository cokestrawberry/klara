{
  "name": "klara",
  "description": "Korean and English wording checked against references instead of intuition",
  "version": "1.0.0",
  "hooks": {
    "hooks": {
      "SessionStart": [
        {
          "hooks": [
            {
              "type": "command",
              "command": "sed '1,/^---$/d' \"$PLUGIN_ROOT/output-styles/language-and-tone.md\"",
              "commandWindows": "powershell -NoProfile -Command \"[Console]::OutputEncoding = [Text.Encoding]::UTF8; [Console]::Out.Write(([IO.File]::ReadAllText([IO.Path]::Combine([Environment]::GetEnvironmentVariable('PLUGIN_ROOT'), 'output-styles', 'language-and-tone.md')) -split '(?m)^---\\r?\\n', 3)[2] -replace '\\r')\""
            }
          ]
        }
      ]
    }
  }
}
